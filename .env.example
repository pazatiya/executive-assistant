# ─────────────────────────────────────────────────────────────
# Executive Assistant — environment
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# --- Data layer -------------------------------------------------
# "libsql" (local file, default) | "supabase" (Postgres in the cloud)
DB_DRIVER=libsql
# Local libSQL/SQLite file (used when DB_DRIVER=libsql)
LIBSQL_URL=file:./data/app.db

# When DB_DRIVER=supabase, fill these (from Supabase project settings):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# --- Auth -----------------------------------------------------
# "dev" (local single-user session, default) | "supabase"
AUTH_DRIVER=dev
AUTH_SESSION_SECRET=change-me-in-production-please-32-chars-min

# --- AI providers -------------------------------------------
# The Assistant/Orchestrator needs at least one provider key.
# Without a key the system runs in MOCK mode (deterministic local replies).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default routing (see src/lib/ai/model-router.ts for the full policy).
# The router fails over to the next available provider on a runtime error,
# and each user can override provider+model from Settings.
AI_DEFAULT_PROVIDER=anthropic
AI_ORCHESTRATOR_MODEL=claude-sonnet-4-5
AI_FAST_MODEL=claude-haiku-4-5-20251001
GOOGLE_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o

# --- Google OAuth (Gmail / Calendar / Drive) --------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: {APP_URL}/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32+ char secret for encrypting stored OAuth tokens at rest
ENCRYPTION_KEY=

# --- App ----------------------------------------------------
APP_URL=http://localhost:4310
APP_TIMEZONE=Asia/Jerusalem
